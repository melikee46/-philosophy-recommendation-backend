# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL) - generate a unique password and URL for each environment.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_A_STRONG_PASSWORD@localhost:5432/philosophy_db?schema=public"

# Docker Compose only. DATABASE_URL must use the same password and the host `postgres`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=philosophy_db

# JWT Authentication
# Generate each value with: openssl rand -base64 48
JWT_ACCESS_SECRET="REPLACE_WITH_A_UNIQUE_48_BYTE_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_48_BYTE_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS
# Comma-separated allowlist; production requires explicit HTTPS origins.
CORS_ORIGIN="http://localhost:3000"

# Required only when running `npm run prisma:seed`; never use known/default passwords.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
